      "text": "Salt: +1 to the brew's highest trait, +2 shelf days"
    },
    {
      "id": "R6",
      "tag": "real",
      "text": "Oily ingredient + water base without beeswax: Separated, max 1 star"
    },
    {
      "id": "R7",
      "tag": "magic",
      "text": "Two highest traits equal and >= 4: Harmonized, +1 star (max 3); not for the Midsummer Draught"
    },
    {
